# Copiar este archivo como ".env.local" y completar.
# En Vercel, cargar las mismas variables en Settings -> Environment Variables.

# ---------------------------------------------------------------- sitio
# Dominio final (para SEO y enlaces de los emails).
NEXT_PUBLIC_SITE_URL=https://vkmultimedia.com.ar

# ---------------------------------------------------------------- SmugMug
# Clave de sólo lectura: https://api.smugmug.com/api/developer/apply
# Con álbumes públicos alcanza con esto, sin usuario ni contraseña.
SMUGMUG_API_KEY=

# Clave del álbum de cada galería. La forma rápida de conseguirlas es listarlas:
#   node tools/listar-albumes.mjs <cuenta-de-smugmug>
#
# El nombre de la variable sale del slug de la galería, en mayúsculas y con
# guiones bajos: "15-anios" -> SMUGMUG_ALBUM_15_ANIOS. Si se agrega un tipo de
# evento en lib/site.ts, su variable se llama igual y no hay que tocar código.
#
# Se pueden poner varios álbumes separados por coma: las fotos de una galería
# se muestran mezcladas, una de cada álbum por vuelta.
SMUGMUG_ALBUM_15_ANIOS=
SMUGMUG_ALBUM_SESIONES=
SMUGMUG_ALBUM_GRADUACIONES=
SMUGMUG_ALBUM_EVENTOS_EMPRESARIALES=
SMUGMUG_ALBUM_VIDEOS=
SMUGMUG_ALBUM_CASAMIENTOS=

# ------------------------------------------------------- portadas del panel
# Las fotos de portada que el fotógrafo elige desde /panel se guardan en un
# archivo. En la compu va a la carpeta "datos/" y no hace falta configurar nada;
# publicado en Vercel no se puede escribir en disco, así que se usa Vercel Blob:
# Vercel -> Storage -> Create Database -> Blob. Al crearlo deja esta variable
# cargada sola. Sin ella la web sigue andando y elige las portadas automáticamente.
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------- emails
# https://resend.com  (plan gratuito: 3.000 emails por mes)
RESEND_API_KEY=
# Casilla del fotógrafo, donde llegan las consultas y los reclamos del beneficio.
EMAIL_DESTINO=
# Remitente verificado en Resend. Mientras se verifica el dominio se puede usar
# el remitente de prueba: Web <onboarding@resend.dev>
EMAIL_DESDE=Web <onboarding@resend.dev>

# ---------------------------------------------------------------- panel
# Acceso al generador de presupuestos (/panel).
PANEL_USUARIO=vladimir
PANEL_CLAVE=
# Texto largo y al azar: firma la cookie de sesión.
# Generarlo con:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
